{
  "kind": "microphone_stream",
  "version": "0.1.1",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Microphone Stream",
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/stream_capture.js"
      },
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      },
      {
        "kind": "js",
        "path": "assets/js/capture_settings.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties_mount.js"
      },
      {
        "kind": "js",
        "path": "assets/js/capture_settings.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/stream_capture.js"
      },
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/node_card.js"
      }
    ]
  },
  "ports": {
    "inputs": [],
    "outputs": [
      {
        "id": 1,
        "name": "audio_out",
        "title": "Audio out",
        "emits": [
          "audio/*"
        ],
        "multiplicity": "many",
        "transport": "audio_stream",
        "audio_stream": {
          "codecs": [
            "opus"
          ],
          "sample_rates_hz": [
            48000
          ],
          "channels": [
            1,
            2
          ],
          "overflow_policy": "drop_oldest"
        }
      },
      {
        "id": 2,
        "name": "command_out",
        "title": "Command out",
        "emits": [
          "application/json"
        ],
        "multiplicity": "many",
        "transport": "message"
      }
    ]
  },
  "config": {
    "timeslice_ms": 250,
    "audio_bits_per_second": 128000,
    "channel_count": 1,
    "max_duration_sec": 3600,
    "continuous_capture": false
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false,
    "allow_required_input": false,
    "default_required": false,
    "max_inputs": 0,
    "max_outputs": 2,
    "default_input_accepts": [
      "audio/*"
    ],
    "default_output_emits": [
      "audio/*"
    ],
    "default_multiplicity": "many"
  },
  "runtime": {
    "initial_state": "ready",
    "runtime_executable": true,
    "active_worker": true,
    "generic_source": true,
    "centralized_executor": "generic",
    "supports_runtime_audio_streams": true,
    "active_execution_policy": "source_on_play"
  }
}
